{
  "name": "encounter-map-forge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "format": "prettier --write src tests scripts *.json *.config.ts README.md",
    "format:check": "prettier --check src tests scripts *.json *.config.ts README.md",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.3",
    "@napi-rs/canvas": "^0.1.80",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "prettier": "^3.6.0",
    "typescript": "6.0.3",
    "vitest": "4.0.18"
  }
}
